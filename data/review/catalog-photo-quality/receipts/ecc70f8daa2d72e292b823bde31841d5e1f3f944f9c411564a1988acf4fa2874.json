.wikimedia.org/w/index.php?curid=82133974","sha1":"899050b64c70233c3534c118d33d03739e0e717a","extmetadata":{"DateTime":{"value":"2019-09-13 18:44:57","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Tom Hanks TIFF 2019","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"A Beautiful Day in the Neighborhood|Tom Hanks in Canada|2019 Toronto International Film Festival|Extracted images|Tom Hanks in 2019|Portrait photographs of Tom Hanks|Files from John Bauld Flickr stream","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Tom Hanks at the 2019 Toronto International Film Festival","source":"commons-desc-page"},"DateTimeOriginal":{"value":"2019-09-07 18:04","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/photos/themollusk/48696326453/\">TIFF 2019 tom hanks</a>","source":"commons-desc-page"},"Artist":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/10584612@N06\">John Bauld</a> from Toronto, Canada","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY 2.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution 2.0","source":"commons-desc-page"},"AttributionRequired":{"value":"true","source":"commons-desc-page","hidden":""},"LicenseUrl":{"value":"https://creativecommons.org/licenses/by/2.0","source":"commons-desc-page"},"Copyrighted":{"value":"True","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"cc-by-2.0","source":"commons-templates","hidden":""}}}]},{"ns":6,"title":"File:Colonel Tom Parker 1969 (cropped).jpg","missing":true,"known":true,"imagerepository":"shared","imageinfo":[{"size":68421,"width":325,"height":435,"url":"https://upload.wikimedia.org/wikipedia/commons/c/ca/Colonel_Tom_Parker_1969_%28cropped%29.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Colonel_Tom_Parker_1969_(cropped).jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=60556605","sha1":"2afc7d15adb600689524115835b88342435cc052","extmetadata":{"DateTime":{"value":"2022-05-29 08:39:52","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Colonel Tom Parker 1969 (cropped)","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Colonel Tom Parker|Extracted images|PD US no notice|Template Unknown (author)","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Elvis Presley and Colonel Tom Parker, 1969","source":"commons-desc-page"},"DateTimeOriginal":{"value":"1969","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"http://www.ebay.com/itm/ELVIS-PRESLEY-COL-PARKER-8x10-Vintage-Original-Photo-1969-CHANGE-OF-HABIT-001-/121885254894?hash=item1c60ed64ee:g:350AAOSwoydWs3NA\">eBay</a>","source":"commons-desc-page"},"Artist":{"value":"Unknown author<span style=\"display: none;\">Unknown author</span>","source":"commons-desc-page"},"Permission":{"value":"<p>This is a publicity photo taken to promote an actor. As stated by film production expert Eve Light Honthaner in <i>The Complete Film Production Handbook</i>, (Focal Press, 2001 p. 211.):\n</p>\n<dl><dd>\"Publicity photos (star headshots) have traditionally not been copyrighted. Since they are disseminated to the public, they are generally considered public domain, and therefore clearance by the studio that produced them is not necessary.\"</dd></dl>\n<p>Nancy Wolff, includes a similar explanation:\n</p>\n<dl><dd>\"There is a vast body of photographs, including but not limited to publicity stills, that have no notice as to who may have created them.\"  (<i>The Professional Photographer's Legal Handbook</i> By Nancy E. Wolff, Allworth Communications, 2007, p. 55.)</dd></dl>\n<p>Film industry author Gerald Mast, in <i>Film Study and the Copyright Law</i> (1989) p. 87, writes:\n</p>\n<dl><dd>\"According to the old copyright act, such production stills were not automatically copyrighted as part of the film and required separate copyrights as photographic stills. The new copyright act similarly excludes the production still from automatic copyright but gives the film's copyright owner a five-year period in which to copyright the stills. Most studios have never bothered to copyright these stills because they were happy to see them pass into the public domain, to be used by as many people in as many publications as possible.\"</dd></dl>\nKristin Thompson, committee chairperson of the <a rel=\"nofollow\" class=\"external text\" href=\"http://www.cmstudies.org/\">Society for Cinema and Media Studies</a> writes in the conclusion of a 1993 conference with cinema scholars and editors, that they \"expressed the opinion that it is not necessary for authors to request permission to reproduce frame enlargements ... [and] some trade presses that publish educational and scholarly film books also take the position that permission is not necessary for reproducing frame enlargements and publicity photographs.\" (<a rel=\"nofollow\" class=\"external text\" href=\"http://c.ymcdn.com/sites/www.cmstudies.org/resource/resmgr/docs/fairusefilmstills.pdf?hhSearchTerms=%22Copyright%22\">\"Fair Usage Publication of Film Stills\" by Kristin Thompson, Society for Cinema and Media Studies</a>)","source":"commons-desc-page","hidden":""},"LicenseShortName":{"value":"Public domain","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Public domain","source":"commons-desc-page"},"AttributionRequired":{"value":"false","source":"commons-desc-page","hidden":""},"Copyrighted":{"value":"False","source":"commons-desc-page","hidden":""},"Restrictions":{"value":"","source":"commons-desc-page","hidden":""},"License":{"value":"pd","source":"commons-templates","hidden":""}}}]},{"ns":6,"title":"File:Golda Meir (1964) cropped.jpg","missing":true,"known":true,"imagerepository":"shared","imageinfo":[{"size":347919,"width":981,"height":1160,"url":"https://upload.wikimedia.org/wikipedia/commons/b/b9/Golda_Meir_%281964%29_cropped.jpg?utm_source=en.wikipedia.org&utm_campaign=imageinfo&utm_content=original","descriptionurl":"https://commons.wikimedia.org/wiki/File:Golda_Meir_(1964)_cropped.jpg","descriptionshorturl":"https://commons.wikimedia.org/w/index.php?curid=141703070","sha1":"bb52b3591a7c579243bf4e4360536b7f0744436f","extmetadata":{"DateTime":{"value":"2023-12-04 04:02:04","source":"mediawiki-metadata","hidden":""},"ObjectName":{"value":"Golda Meir (1964) cropped","source":"mediawiki-metadata"},"CommonsMetadataExtension":{"value":1.2,"source":"extension","hidden":""},"Categories":{"value":"Images with extracted images|Extracted images|Photographs by Willem van de Poll in Israel (1964)|Golda Meir in 1964|Portraits of Israelis by Willem van de Poll","source":"commons-categories","hidden":""},"Assessments":{"value":"","source":"commons-categories","hidden":""},"ImageDescription":{"value":"Golda Meir, Minister of Foreign Affairs of Israel (1964)","source":"commons-desc-page"},"DateTimeOriginal":{"value":"1964","source":"commons-desc-page"},"Credit":{"value":"<a rel=\"nofollow\" class=\"external text\" href=\"http://proxy.handle.net/10648/aedf03fc-d0b4-102d-bcf8-003048976d84\">Nationaal Archief</a> Nummer toegang 2.24.14.02 Bestanddeelnummer 255-4314","source":"commons-desc-page"},"Artist":{"value":"Willem van de Poll","source":"commons-desc-page"},"LicenseShortName":{"value":"CC BY-SA 4.0","source":"commons-desc-page","hidden":""},"UsageTerms":{"value":"Creative Commons Attribution-Share Alike 4.0","source":"commons-desc-page"},"A