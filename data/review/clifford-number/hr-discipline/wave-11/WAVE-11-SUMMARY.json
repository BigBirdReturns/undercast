{"schema_version":1,"wave_id":"CN-HRAC-W11","as_of":"2026-08-03","title":"Retained burden, authorship, corrective authority, and consequence custody","central_rule":"Accountability requires named authorship, an owner with corrective power, a recorded consequence decision, worker or record repair where warranted, system correction, and recurrence escalation. Training alone is not accountability.","counts":{"public_sources":24,"private_sources":0,"lanes":6,"observations":36,"findings":24,"consequence_states":16,"consequence_cells":96,"consequence_status":{"recovered_present":28,"recovered_absent":6,"partial":29,"blocked":33,"not_applicable":0},"actor_categories":12,"actor_cells":72,"consequence_stages":10,"consequence_records":6,"proposed_controls":18,"adopted_controls":0,"chloe_ai_use_findings":0},"case_lifecycle":{"HRAC-01":"inquest_and_reported_training_visible_complete_authorship_consequence_repair_and_verified_prevention_open","HRAC-02":"formal_failure_findings_and_redesign_visible_complete_personal_consequence_and_repair_ledger_open","HRAC-03":"pfd_programmes_and_followup_review_visible_personal_consequence_and_worker_outcomes_open","HRAC-04":"pfd_and_pledged_review_visible_official_response_ownership_consequence_and_repair_incomplete","HRAC-05":"multiple_recipients_visible_joined_ownership_and_consequence_receipt_open","HRAC-06":"causative_custody_findings_and_recurrence_visible_complete_consequence_repair_and_operation_verification_open"},"interpretive_law":["A finding is not personal culpability.","Public silence is not proof that no consequence occurred.","Training is not accountability.","Policy revision is not worker repair.","A named recipient is not necessarily an accountable decision owner.","Manager attendance is not corrective authority.","Oversight activity is not complete consequence custody.","Recurrence is not universal prevalence."],"inherited_source_id_url_map_sha256":"217702eee723a470cdc41884254625db3f112c746b39323181ac0bba4ad4b4f4","authority"