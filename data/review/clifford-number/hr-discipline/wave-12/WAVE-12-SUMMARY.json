{"schema_version":1,"wave_id":"CN-HRBA-W12","as_of":"2026-08-03","title":"Consequence asymmetry, burden transfer, and cost internalization","central_rule":"An institution has not internalized harm when affected people, families, and public systems absorb the irreversible cost while the institution records only training, policy revision, or reputational management.","counts":{"public_sources":24,"private_sources":0,"lanes":6,"observations":36,"findings":24,"burden_states":18,"burden_cells":108,"burden_status":{"recovered_present":41,"recovered_absent":0,"partial":25,"blocked":36,"not_applicable":6},"actor_categories":12,"actor_cells":72,"internalization_stages":10,"burden_records":6,"proposed_controls":18,"adopted_controls":0,"chloe_ai_use_findings":0},"case_lifecycle":{"HRBA-01":"human_and_family_burden_visible_institutional_internalization_personal_consequence_repair_compensation_and_verified_prevention_open","HRBA-02":"formal_failure_and_reform_cost_visible_personal_consequence_compensation_and_complete_repair_open","HRBA-03":"human_public_and_operational_burden_visible_personal_consequence_repair_and_effectiveness_open","HRBA-04":"human_family_and_public_oversight_burden_visible_internal_cost_consequence_and_repair_open","HRBA-05":"human_employment_and_public_process_burden_visible_joined_institutional_cost_consequence_and_repair_open","HRBA-06":"human_public_service_and_recurrence_burden_visible_personal_consequence_repair_and_cost_internalization_open"},"interpretive_law":["Human harm is not an institution cost merely because it becomes public.","Training is not accountability.","Policy revision is not worker repair.","A named recipient is not a named decision owner.","A missing public consequence record cannot prove that no consequence occurred.","Compensation is not system correction.","Recurrence without increased accountable burden is not learning.","A surviving workforce is not the complete affected population."],"inherited_source_id_url_map_sha256":"21770