{
  "version": 1,
  "schema": "undercast-thesis-rails@1",
  "project": "UNDERCAST",
  "thesis": "A field index of real performers who disappear under a designed face, prosthetics, a mask, a creature suit, motion capture, or an unseen voice. Every canonical increment must improve the character-to-performer reveal, its exact evidence, its media, or the credited creative labor behind it.",
  "active_estate_states": [
    "active-corpus",
    "gold-reference"
  ],
  "in_flight_statuses": [
    "leased",
    "drafted",
    "merged"
  ],
  "default_agent": "luna",
  "capability_profile": "text-vision",
  "batch_limit": 1,
  "batch_path": ".luna/batch.json",
  "autopilot_prompt_path": ".luna/AUTOPILOT-PROMPT.md",
  "continuation_prompt_path": ".luna/THESIS-CONTINUATION.md",
  "terminal_contract": {
    "maximum_tasks_per_cycle": 1,
    "required_in_flight": 0,
    "required_media_debt": 0,
    "required_unreceipted_cycles": 0,
    "temporary_cycle_refs": 0,
    "maker_attribution_may_remain_unresolved": true,
    "require_reviewed_cycle_receipt": true
  },
  "product_contract": {
    "character_to_performer_reveal": true,
    "separate_character_and_performer_media": true,
    "exact_subject_or_honest_absence": true,
    "source_receipts_required": true,
    "maker_credit_requires_exact_source": true,
    "collection_only": true
  },
  "forbidden_default_work": [
    "new product surface",
    "new reveal mechanic",
    "new canonical record concept",
    "new generic governance layer",
    "cycle-specific selector or preflight",
    "cycle-specific media census or blueprint",
    "cycle-specific modality desk when the queued mode is already adjudicated",
    "transition-only observer or controller",
    "separate finalizer census when the reviewed candidate already fixes the denominator",
    "cleanup-writer version chain",
    "owner physical action or outside-human dependency"
  ],
  "workflow_policy": {
    "cycle_workflow_pattern": "^\\.github/workflows/[a-z0-9-]+-cycle-([0-9]{3})-",
    "forbidden_stage_tokens": [
      "selector",
      "preflight",
      "blueprint",
      "media-census",
      "finalizer-census",
      "candidate-transition",
      "review-transition",
      "transition-controller",
      "lifecycle-observer",
      "cleanup-writer",
      "selection-cleanup",
      "transport-cleanup",
      "source-export",
      "history-rebuilder",
      "materializer-derivation",
      "materializer-review"
    ],
    "maximum_changed_cycle_workflows_per_pr": 3,
    "terminal_product_marker": "Terminal-Product:",
    "exception_markers": [
      "Thesis-Rail-Exception:",
      "Shared-Mechanism-Gap:",
      "Retirement-Condition:"
    ],
    "minimum_enforced_cycle": 13
  },
  "required_files": [
    "AGENTS.md",
    "docs/COLLECTION-OPERATIONS.md",
    "docs/THESIS-CONTINUATION.md",
    "scripts/thesis-rails.mjs",
    "scripts/lib/thesis-rails.mjs",
    "scripts/thesis-rails-fixtures.mjs",
    "data/THESIS-RAILS.json",
    ".github/workflows/thesis-rails.yml"
  ]
}
