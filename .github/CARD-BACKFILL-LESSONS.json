  "lessons": [
    {
      "id": "CBL-001",
      "title": "Claim types remain separate",
      "introduced_in_version": 1,
      "status": "active",
      "mandatory": true,
      "observed_in": [
        "serial packets 001-040",
        "PR-129"
      ],
      "rule": "Actor, character, production, chronology, source publication, selected bytes, and visual presentation are separate claims.",
      "cultivation": "Typed schemas and adjudication prompts replace one-off holistic judgment.",
      "enforcement": [
        {
          "kind": "contains",
          "path": "scripts/card-backfill-machine-adjudicate.mjs",
          "all": [
            "required_identity_value: \"expected\"",
            "required_presentation_value: review.visual_adjudication?.required_presentation_value",
            "Appearance is never identity evidence."
          ]
        },
        {
          "kind": "contains",
          "path": "scripts/card-backfill-cohort-adjudicate.mjs",
          "all": [
            "decision.identity !== \"expected\"",
            "decision.presentation !== expectedPresentation"
          ]
        }
      ]
    },
    {
      "id": "CBL-002",
      "title": "Selected bytes never prove their own identity",
      "introduced_in_version": 1,
      "status": "active",
      "mandatory": true,
      "observed_in": [
        "serial packets 001-040"
      ],
      "rule": "Appearance may be used only for presentation; identity and role require independent textual custody.",
      "cultivation": "Every packet records the non-self-proving boundary and the second desk enforces it.",
      "enforcement": [
        {
          "kind": "contains",
          "path": "scripts/card-backfill-cohort-packetize.mjs",
          "all": [
            "selected_image_does_not_independently_prove_identity_or_role: true"
          ]
        },
        {
          "kind": "contains",
          "path": "scripts/card-backfill-machine-adjudicate.mjs",
          "all": [
            "Do not identify a person or character from appearance."
          ]
        }
      ]
    },
    {
      "id": "CBL-003",
      "title": "Discovery cannot self-approve",
      "introduced_in_version": 1,
      "status": "active",
      "mandatory": true,
      "observed_in": [
        "serial packets 001-040"
      ],
      "rule": "Candidate discovery and final identity/presentation adjudication remain independent desks.",
      "cultivation": "The packet and workflow require a qualified machine or person second desk.",
      "enforcement": [
        {
          "kind": "contains",
          "path": "scripts/card-backfill-cohort-packetize.mjs",
          "all": [
            "\"discoverer_may_not_self-approve\": true",
            "qualified_machine_or_person_second_desk_allowed: true"
          ]
        },
        {
          "kind": "contains",
          "path": "scripts/card-backfill-cohort-adjudicate.mjs",
          "all": [
            "adjudicator.independent_from_discovery !== true"
          ]
        }
      ]
    },
    {
      "id": "CBL-004",
      "title": "Canonical mutation remains a separate transaction",
      "introduced_in_version": 1,
      "status": "active",
      "mandatory": true,
      "observed_in": [
        "serial packets 001-040",
        "PR-129"
      ],
      "rule": "Discovery, adjudication, staging, and evidence publication do not mutate canonical website fields.",
      "cultivation": "The campaign control and every receipt fail closed on canonical mutation.",
      "enforcement": [
        {
          "kind": "json-equals",
          "path": ".github/CARD-BACKFILL-COHORT.json",
          "pointer": "/invariants/canonical_mutation_false_until_separate_acceptance",
          "value": true
        },
        {
          "kind": "contains",
          "path": "scripts/lib/card-backfill-staging.mjs",
          "all": [
            "row.canonical_mutation !== false",
            "canonical_mutation: false"
          ]
        }
      ]
    },
    {
      "id": "CBL-005",
      "title": "Repository-wide duplicate screening",
      "introduced_in_version": 1,
      "status": "active",
      "mandatory": true,
      "observed_in": [
        "serial packets 001-040"
      ],
      "rule": "Source and rendered bytes are screened against the complete canonical media hash estate.",
      "cultivation": "One reusable hash index prevents per-card duplicate judgment.",
      "enforcement": [
        {
          "kind": "contains",
          "path": "scripts/card-backfill-cohort-packetize.mjs",
          "all": [
            "buildRepositoryHashIndex",
            "rendered-canonical-byte-duplicate",
            "repository_hash_count"
          ]
        },
        {
          "kind": "contains",
          "path": "scripts/card-backfill-source-v2.mjs",
          "all": [
            "buildRepositoryHashIndex",
            "canonical-byte-duplicate"
          ]
        }
      ]
    },
    {
      "id": "CBL-006",
      "title": "Deterministic render with full-source context",
      "introduced_in_version": 1,
      "status": "active",
      "mandatory": true,
      "observed_in": [
        "serial packets 001-040"
      ],
      "rule": "Every candidate render is deterministic and preserves both proposed framing and the complete source image.",
      "cultivation": "A shared renderer replaces card-specific render judgment.",
      "enforcement": [
        {
          "kind": "json-equals",
          "path": ".github/CARD-BACKFILL-COHORT.json",
          "pointer": "/render/deterministic",
          "value": true
        },
        {
          "kind": "json-equals",
          "path": ".github/CARD-BACKFILL-COHORT.json",
          "pointer": "/render/full_source_edges_visible",
          "value": true
        },
        {
          "kind": "contains",
          "path": "scripts/card-backfill-machine-adjudicate.mjs",
          "all": [
            "the lower region preserves the complete source image"
          ]
        }
      ]
    },
    {
      "id": "CBL-007",
      "title": "Typed exceptions do not stop the cohort",
      "introduced_in_version": 1,
      "status": "active",
      "mandatory": true,
      "observed_in": [
        "serial packets 001-040",
        "workflow run 30513656297"
