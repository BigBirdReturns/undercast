octor-who-cycle-011.mjs | tee "$OUT/logs/cycle-011-candidate.log"',
'  node scripts/autopilot.mjs validate | tee "$OUT/logs/autopilot-candidate.log"',
])+'\n'
new_checks='\n'.join([
"  printf '%s\\n' 'senstarg-finalizer-v1: historical cycle checkers deferred until cycle-012 registry closure' | tee \"$OUT/logs/historical-checkers-deferred.log\"",
'  node scripts/autopilot.mjs validate | tee "$OUT/logs/autopilot-candidate.log"',
])+'\n'
assert s.count(old_checks)==1
s=s.replace(old_checks,new_checks)
old_review='  "reviewed_by": {"id": "chatgpt-second-desk", "role": "second-desk"},\n'
new_review='  "reviewed_by": "chatgpt-second-desk",\n  "reviewed_role": "second-desk",\n'
assert s.count(old_review)==1
s=s.replace(old_review,new_review)
old_evidence='''  "evidence": [
    {"kind": "candidate_artifact", "source": "github-actions-run:$CANDIDATE_RUN/artifact:$CANDIDATE_ARTIFACT", "sha256": "$CANDIDATE_ZIP_SHA256"},
    {"kind": "candidate_receipt", "source": "artifact:$CANDIDATE_ARTIFACT", "sha256": "$CANDIDATE_RECEIPT_ID"},
    {"kind": "independent_review_artifact", "source": "github-actions-run:$REVIEW_RUN/artifact:$REVIEW_ARTIFACT", "sha256": "$REVIEW_ZIP_SHA256"},
    {"kind": "independent_review", "source": "review-artifact:$REVIEW_ARTIFACT", "sha256": "$REVIEW_IDENTITY"}
  ],
'''
new_evidence='''  "evidence": [
    {"type": "workflow-run", "value": "Candidate run $CANDIDATE_RUN job $CANDIDATE_JOB artifact $CANDIDATE_ARTIFACT and independent review run $REVIEW_RUN job $REVIEW_JOB artifact $REVIEW_ARTIFACT"},
    {"type": "commit", "value": "$LOCAL_CANDIDATE_COMMIT; exact reviewed candidate tree $REVIEW_REBASED_TREE"},
    {"type": "restart-proof", "value": "Candidate artifact sha256 $CANDIDATE_ZIP_SHA256, candidate receipt $CANDIDATE_RECEIPT_ID, review artifact sha256 $REVIEW_ZIP_SHA256, review identity $REVIEW_IDENTITY"}
  ],
'''
assert s.count(old_evidence)==1
s=s.