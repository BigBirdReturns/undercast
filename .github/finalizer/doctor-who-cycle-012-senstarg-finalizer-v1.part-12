eviewed candidate tree $REVIEW_REBASED_TREE"},
    {"type": "restart-proof", "value": "Candidate artifact sha256 $CANDIDATE_ZIP_SHA256, candidate receipt $CANDIDATE_RECEIPT_ID, review artifact sha256 $REVIEW_ZIP_SHA256, review identity $REVIEW_IDENTITY"}
  ],
'''
assert s.count(old_evidence)==1
s=s.replace(old_evidence,new_evidence)
old_note='  "notes": "Doctor Who cycle 012 resolves Dan Starkey as Senstarg in The Vanquishers as a physical-prosthetic face performance. Maker attribution remains unresolved and nonblocking."\n'
new_note='  "note": "Doctor Who cycle 012 resolves Dan Starkey as Senstarg in The Vanquishers as a physical-prosthetic face performance. Maker attribution remains unresolved and nonblocking."\n'
assert s.count(old_note)==1
s=s.replace(old_note,new_note)
old_registry='estate[\'next_gate\']=f"Doctor Who cycle 012 {cycle[\'id\']} resolved Dan Starkey as Senstarg within the preserved 316-role denominator; 304 tasks remain queued. Exact character and performer media are verified separately, maker attribution remains unresolved, and any later cycle must begin from the repository-native thesis rail."\n'
new_registry='estate[\'next_gate\']=f"Doctor Who reviewed cycle 012 {cycle[\'id\']} resolved Dan Starkey as Senstarg within the preserved 316-role denominator; 304 tasks remain queued. Exact character and performer media are verified separately, maker attribution remains unresolved, and any later cycle must begin from the repository-native thesis rail."\n'
assert s.count(old_registry)==1
s=s.replace(old_registry,new_registry)
dst.write_text(s)
PYREPAIR
test "$(wc -c < /tmp/senstarg-finalizer-v1-exec.sh | tr -d ' ')" = 43768
test "$(sha256sum /tmp/senstarg-finalizer-v1-exec.sh | cut -d' ' -f1)" = bb406180d02c8bbb9a5762c31de66061617de47305990952c203a24848b368