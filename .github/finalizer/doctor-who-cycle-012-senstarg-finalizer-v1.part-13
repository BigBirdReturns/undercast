git','bundle','verify',str(r/'product.bundle')],check=True)
PY
git fetch "$FINAL/product.bundle" refs/heads/senstarg-product:refs/remotes/senstarg-product
P="$(cat "$FINAL/product-commit.txt")" T="$(cat "$FINAL/product-tree.txt")"
test "$(git show -s --format=%P "$P")" = "$GITHUB_SHA"
test "$(git show -s --format=%T "$P")" = "$T"
test -z "$(git ls-tree -r --name-only "$T" | grep -E '^\.github/(workflows/doctor-who-cycle-012-senstarg-finalizer-v1\.yml|finalizer/doctor-who-cycle-012-senstarg-finalizer-v1\.part-)')"
test "$(git diff --name-only "$PREINSTALL_MAIN" "$P" | wc -l | tr -d ' ')" = 49
test "$(gh api "/repos/$GITHUB_REPOSITORY/git/ref/heads/main" --jq .object.sha)" = "$GITHUB_SHA"
git push origin "$P:refs/heads/main"
test "$(gh api "/repos/$GITHUB_REPOSITORY/git/ref/heads/main" --jq .object.sha)" = "$P"
PRODUCT_COMMIT="$P" PRODUCT_TREE="$T" ROOT="$FINAL" python3 - <<'PY'
import hashlib,json,os
from pathlib import Path
r=Path(os.environ['ROOT']); q=json.loads((r/'qualification.json').read_text())
x={'version':1,'status':'cycle-012-senstarg-canonical-publication-complete','run':int(os.environ['GITHUB_RUN_ID']),'attempt':int(os.environ['GITHUB_RUN_ATTEMPT']),'installed_main':os.environ['GITHUB_SHA'],'product_commit':os.environ['PRODUCT_COMMIT'],'product_tree':os.environ['PRODUCT_TREE'],'qualification_identity':q['identity'],'cycle_id':q['cycle']['cycle_id'],'queue':q['cycle']['queue'],'maker_attribution':'unresolved','force_update':False}
x['identity']=hashlib.sha256(json.dumps(x,sort_keys=True,separators=(',',':')).encode()).hexdigest(); (r/'publication-receipt.json').write_text(json.dumps(x,indent=2,sort_keys=True)+'\n')
PY
