cat .github/finalizer/doctor-who-cycle-012-senstarg-finalizer-v1.part-0[1-8] > /tmp/senstarg-finalizer-v1.sh.gz.b64
test "$(wc -c < /tmp/senstarg-finalizer-v1.sh.gz.b64 | tr -d ' ')" = 15284
test "$(sha256sum /tmp/senstarg-finalizer-v1.sh.gz.b64 | cut -d' ' -f1)" = c7b7cd943f9cbf28642d1268687cd5c22be55af29ca4bc5318bd98dc5fe93bde
base64 -d /tmp/senstarg-finalizer-v1.sh.gz.b64 > /tmp/senstarg-finalizer-v1.sh.gz
test "$(sha256sum /tmp/senstarg-finalizer-v1.sh.gz | cut -d' ' -f1)" = be1f1223c6e24eb055226bd36f79595789508677e4e4a331a42493655dc78b6d
gzip -dc /tmp/senstarg-finalizer-v1.sh.gz > /tmp/senstarg-finalizer-v1.sh
test "$(sha256sum /tmp/senstarg-finalizer-v1.sh | cut -d' ' -f1)" = 57ac78d4960c71369298e4095452898260853089a803c16319dc41f14b6eeee6
bash -n /tmp/senstarg-finalizer-v1.sh
bash /tmp/senstarg-finalizer-v1.sh
FINAL="$OUT/final" ROOT="$OUT/final" python3 - <<'PY'
import hashlib,json,os
from pathlib import Path
r=Path(os.environ['ROOT']); h=lambda b:hashlib.sha256(b).hexdigest(); p=r/'SHA256SUMS.pre'
assert (r/'SHA256SUMS').read_text().split()[0]==h(p.read_bytes())
for x in p.read_text().splitlines():
 if x.strip():
  d,n=x.split(None,1); f=r/n.strip().lstrip('*').removeprefix('./'); assert f.is_file() and h(f.read_bytes())==d
q=json.loads((r/'qualification.json').read_text()); b=dict(q); i=b.pop('identity')
assert i==h(json.dumps(b,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode())
assert q['status']=='cycle-012-senstarg-receipt-bearing-product-qualified' and q['canonical']['installed_main']==os.environ['GITHUB_SHA'] and q['canonical']['paths']==49
assert all(q['gates'].values()) and q['boundary']['product_tree_transport_free'] and not q['boundary']['maker_attribution_resolved']
assert q['cycle']['queue']=={'total':316,'queued':304,'resolved':12,'in_flight':0} and q['cycle']['maker_attribution']=='unresolved'
PY
git bundle verify "$FINAL/product.bundle"
git fetch "$FINAL/product.bundle" refs/heads/senstarg-product:refs/remotes/senstarg-product
P="$(cat "$FINAL/product-commit.txt")" T="$(cat "$FINAL/product-tree.txt")"
test "$(git show -s --format=%P "$P")" = "$GITHUB_SHA"; test "$(git show -s --format=%T "$P")" = "$T"
test -z "$(git ls-tree -r --name-only "$T" | grep -E '^\.github/(workflows/doctor-who-cycle-012-senstarg-finalizer-v1\.yml|finalizer/doctor-who-cycle-012-senstarg-finalizer-v1\.part-)')"
test "$(git diff --name-only "$PREINSTALL_MAIN" "$P" | wc -l | tr -d ' ')" = 49
test "$(gh api "/repos/$GITHUB_REPOSITORY/git/ref/heads/main" --jq .object.sha)" = "$GITHUB_SHA"
git push origin "$P:refs/heads/main"
