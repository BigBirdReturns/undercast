{
  "$id": "https://bigbirdreturns.github.io/undercast/schema/clifford-number-hr-counterpower-effects-lane.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "additionalProperties": {
        "const": false
      },
      "type": "object"
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "claim": {
            "minLength": 20,
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "limits": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "independently_supported_scoped",
              "effect_recovered_scoped",
              "bounded_synthesis"
            ]
          }
        },
        "required": [
          "id",
          "claim",
          "status",
          "source_ids",
          "limits"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "jurisdiction": {
      "minLength": 3,
      "type": "string"
    },
    "lane_id": {
      "pattern": "^HRDCE-0[1-6]$"
    },
    "named_objects": {
      "items": {
        "minLength": 2,
        "type": "string"
      },
      "minItems": 2,
      "type": "array"
    },
    "observations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "event": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "statement": {
            "minLength": 20,
            "type": "string"
          }
        },
        "required": [
          "id",
          "event",
          "statement",
          "source_ids"
        ],
        "type": "object"
      },
      "maxItems": 6,
      "minItems": 6,
      "type": "array"
    },
    "schema_version": {
      "const": 1
    },
    "source_ids": {
      "items": {
        "minLength": 3,
        "type": "string"
      },
      "minItems": 3,
      "type": "array",
      "uniqueItems": true
    },
    "terminal_receipt": {
      "additionalProperties": false,
      "properties": {
        "closed_questions": {
          "maxItems": 0,
          "type": "array"
        },
        "open_questions": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array",
          "uniqueItems": true
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "state",
        "open_questions",
        "closed_questions"
      ],
      "type": "object"
    },
    "title": {
      "minLength": 10,
      "type": "string"
    },
    "wave_id": {
      "const": "CN-HRDCE-W06"
    }
  },
  "required": [
    "schema_version",
    "wave_id",
    "lane_id",
    "title",
    "jurisdiction",
    "named_objects",
    "source_ids",
    "observations",
    "findings",
    "terminal_receipt",
    "authority"
  ],
  "title": "Clifford Number HR counterpower-effects lane",
  "type": "object"
}
