{
  "$id": "https://github.com/BigBirdReturns/undercast/schema/clifford-number-hr-selection-lane.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "additionalProperties": false,
      "properties": {
        "canonical_product_effects_allowed": {
          "const": false
        },
        "decision_receipt_adoption_allowed": {
          "const": false
        },
        "employer_liability_findings_allowed": {
          "const": false
        },
        "graph_effects_allowed": {
          "const": false
        },
        "individual_culpability_findings_allowed": {
          "const": false
        },
        "legal_conclusions_allowed": {
          "const": false
        },
        "private_source_publication_allowed": {
          "const": false
        },
        "publication_effects_allowed": {
          "const": false
        },
        "universal_prevalence_findings_allowed": {
          "const": false
        }
      },
      "required": [
        "canonical_product_effects_allowed",
        "decision_receipt_adoption_allowed",
        "employer_liability_findings_allowed",
        "graph_effects_allowed",
        "individual_culpability_findings_allowed",
        "legal_conclusions_allowed",
        "private_source_publication_allowed",
        "publication_effects_allowed",
        "universal_prevalence_findings_allowed"
      ],
      "type": "object"
    },
    "decisive_join": {
      "minLength": 1,
      "type": "string"
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "claim": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "limits": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "status": {
            "enum": [
              "seed_supported",
              "seed_synthesis",
              "blocked",
              "normative_proposal"
            ]
          }
        },
        "required": [
          "id",
          "claim",
          "status",
          "source_ids",
          "limits"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "genealogy_stage": {
      "minLength": 1,
      "type": "string"
    },
    "lane_id": {
      "pattern": "^HR-0[1-8]$",
      "type": "string"
    },
    "object_type": {
      "const": "hr_selection_lane"
    },
    "observations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "notes": {
            "minLength": 1,
            "type": "string"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "state": {
            "enum": [
              "reported_in_seed",
              "derived_from_seed",
              "reported_in_private_seed",
              "private_source_unmaterialized",
              "normative_seed",
              "blocked"
            ]
          },
          "subject": {
            "minLength": 1,
            "type": "string"
          },
          "value": {}
        },
        "required": [
          "id",
          "subject",
          "field",
          "state",
          "value",
          "source_ids",
          "notes"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": 1
    },
    "selection_rule": {
      "minLength": 1,
      "type": "string"
    },
    "source_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "terminal_receipt": {
      "additionalProperties": false,
      "properties": {
        "closed_control_questions": {
          "maxItems": 0,
          "type": "array"
        },
        "open_control_questions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "prohibited_inferences": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "state": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "state",
        "closed_control_questions",
        "open_control_questions",
        "prohibited_inferences"
      ],
      "type": "object"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "wave_id": {
      "const": "CN-HR-W01"
    }
  },
  "required": [
    "schema_version",
    "object_type",
    "wave_id",
    "lane_id",
    "title",
    "genealogy_stage",
    "decisive_join",
    "selection_rule",
    "authority",
    "source_ids",
    "observations",
    "findings",
    "terminal_receipt"
  ],
  "title": "Clifford Number HR-selection evidence-only lane",
  "type": "object"
}
