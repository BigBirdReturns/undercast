{
  "$id": "https://github.com/BigBirdReturns/undercast/schema/clifford-number-hr-governance-lane.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "additionalProperties": false,
      "properties": {
        "candidate_entitlement_findings_allowed": {
          "const": false
        },
        "canonical_product_effects_allowed": {
          "const": false
        },
        "control_adoption_allowed": {
          "const": false
        },
        "employer_liability_findings_allowed": {
          "const": false
        },
        "employer_specific_causation_findings_allowed": {
          "const": false
        },
        "graph_effects_allowed": {
          "const": false
        },
        "individual_culpability_findings_allowed": {
          "const": false
        },
        "legal_conclusions_allowed": {
          "const": false
        },
        "private_source_publication_allowed": {
          "const": false
        },
        "publication_effects_allowed": {
          "const": false
        },
        "universal_prevalence_findings_allowed": {
          "const": false
        },
        "wave_02_mutation_allowed": {
          "const": false
        }
      },
      "required": [
        "canonical_product_effects_allowed",
        "candidate_entitlement_findings_allowed",
        "control_adoption_allowed",
        "employer_liability_findings_allowed",
        "employer_specific_causation_findings_allowed",
        "graph_effects_allowed",
        "individual_culpability_findings_allowed",
        "legal_conclusions_allowed",
        "private_source_publication_allowed",
        "publication_effects_allowed",
        "universal_prevalence_findings_allowed",
        "wave_02_mutation_allowed"
      ],
      "type": "object"
    },
    "decisive_join": {
      "minLength": 1,
      "type": "string"
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "claim": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "pattern": "^hrg0[1-6]-f[1-4]$",
            "type": "string"
          },
          "limits": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "source_ids": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "bounded_synthesis",
              "normative_proposal",
              "official_guidance_recovered",
              "operative_burden_recovered",
              "remains_blocked",
              "research_mechanism_recovered",
              "scheduled_burden_recovered",
              "vendor_boundary_recovered"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "claim",
          "status",
          "source_ids",
          "limits"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "lane_id": {
      "pattern": "^HRG-0[1-6]$",
      "type": "string"
    },
    "observations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "pattern": "^hrg0[1-6]-o[1-6]$",
            "type": "string"
          },
          "notes": {
            "minLength": 1,
            "type": "string"
          },
          "source_ids": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "state": {
            "enum": [
              "blocked",
              "observed_guidance",
              "observed_operative",
              "observed_research",
              "observed_rule",
              "observed_vendor_documentation",
              "scheduled_not_operative",
              "voluntary"
            ],
            "type": "string"
          },
          "subject": {
            "minLength": 1,
            "type": "string"
          },
          "value": {}
        },
        "required": [
          "id",
          "subject",
          "field",
          "state",
          "value",
          "source_ids",
          "notes"
        ],
        "type": "object"
      },
      "maxItems": 6,
      "minItems": 6,
      "type": "array"
    },
    "schema_version": {
      "const": 1
    },
    "selection_rule": {
      "minLength": 1,
      "type": "string"
    },
    "source_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "terminal_receipt": {
      "additionalProperties": false,
      "properties": {
        "closed_questions": {
          "maxItems": 0,
          "type": "array"
        },
        "open_questions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "prohibited_inferences": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "state": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "state",
        "closed_questions",
        "open_questions",
        "prohibited_inferences"
      ],
      "type": "object"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "wave_id": {
      "const": "CN-HR-W03"
    }
  },
  "required": [
    "schema_version",
    "wave_id",
    "lane_id",
    "title",
    "decisive_join",
    "selection_rule",
    "authority",
    "source_ids",
    "observations",
    "findings",
    "terminal_receipt"
  ],
  "title": "Clifford Number HR governance lane",
  "type": "object"
}
