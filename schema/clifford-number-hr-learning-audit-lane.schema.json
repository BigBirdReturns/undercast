{
  "$id": "https://bigbirdreturns.github.io/undercast/schema/clifford-number-hr-learning-audit-lane.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "type": "object"
    },
    "control_question": {
      "minLength": 20,
      "type": "string"
    },
    "findings": {
      "items": {
        "type": "object"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "lane_id": {
      "pattern": "^HRDL-0[1-6]$",
      "type": "string"
    },
    "observations": {
      "items": {
        "type": "object"
      },
      "maxItems": 6,
      "minItems": 6,
      "type": "array"
    },
    "open_questions": {
      "items": {
        "type": "string"
      },
      "minItems": 4,
      "type": "array"
    },
    "schema_version": {
      "const": 1
    },
    "source_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 3,
      "type": "array",
      "uniqueItems": true
    },
    "terminal_receipt": {
      "minLength": 20,
      "type": "string"
    },
    "title": {
      "minLength": 10,
      "type": "string"
    },
    "wave_id": {
      "const": "CN-HRDL-W07"
    }
  },
  "required": [
    "schema_version",
    "wave_id",
    "lane_id",
    "title",
    "control_question",
    "source_ids",
    "observations",
    "findings",
    "open_questions",
    "terminal_receipt",
    "authority"
  ],
  "title": "Clifford Number HR learning-audit lane",
  "type": "object"
}
