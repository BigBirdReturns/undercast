{
  "$id": "https://github.com/BigBirdReturns/undercast/schema/residual-denominator-lane.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "additionalProperties": false,
      "properties": {
        "reviewed_disposition_changes_allowed": {
          "const": false
        },
        "complete_compact_findings_allowed": {
          "const": false
        },
        "racial_order_findings_allowed": {
          "const": false
        },
        "prevalence_findings_allowed": {
          "const": false
        },
        "coordination_findings_allowed": {
          "const": false
        },
        "common_purpose_findings_allowed": {
          "const": false
        },
        "graph_effects_allowed": {
          "const": false
        },
        "publication_effects_allowed": {
          "const": false
        }
      },
      "required": [
        "reviewed_disposition_changes_allowed",
        "complete_compact_findings_allowed",
        "racial_order_findings_allowed",
        "prevalence_findings_allowed",
        "coordination_findings_allowed",
        "common_purpose_findings_allowed",
        "graph_effects_allowed",
        "publication_effects_allowed"
      ],
      "type": "object"
    },
    "decisive_join": {
      "minLength": 1,
      "type": "string"
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "claim": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "limits": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "source_ids": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "supported",
              "partial",
              "blocked",
              "not_supported"
            ]
          }
        },
        "required": [
          "id",
          "claim",
          "status",
          "source_ids",
          "limits"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "lane_id": {
      "pattern": "^RD-0[1-6]$",
      "type": "string"
    },
    "observations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "notes": {
            "minLength": 1,
            "type": "string"
          },
          "source_ids": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "state": {
            "enum": [
              "observed",
              "conditional",
              "unrecovered",
              "not_observed",
              "not_applicable",
              "blocked"
            ]
          },
          "subject": {
            "minLength": 1,
            "type": "string"
          },
          "value": {}
        },
        "required": [
          "id",
          "subject",
          "field",
          "state",
          "value",
          "source_ids",
          "notes"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": 1
    },
    "selection_rule": {
      "minLength": 1,
      "type": "string"
    },
    "sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "accessed": {
            "const": "2026-08-01"
          },
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "enum": [
              "official",
              "filing",
              "decision",
              "manual",
              "directory",
              "dataset",
              "report"
            ]
          },
          "limits": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "published": {
            "type": [
              "string",
              "null"
            ]
          },
          "publisher": {
            "minLength": 1,
            "type": "string"
          },
          "supports": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "title": {
            "minLength": 1,
            "type": "string"
          },
          "url": {
            "pattern": "^https://",
            "type": "string"
          }
        },
        "required": [
          "id",
          "publisher",
          "title",
          "url",
          "accessed",
          "kind",
          "supports",
          "limits"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "terminal_receipt": {
      "additionalProperties": false,
      "properties": {
        "closed_residual_classes": {
          "maxItems": 0,
          "type": "array"
        },
        "open_residual_classes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "prohibited_inferences": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "state": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "state",
        "closed_residual_classes",
        "open_residual_classes",
        "prohibited_inferences"
      ],
      "type": "object"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "wave_id": {
      "const": "RD-W01"
    }
  },
  "required": [
    "schema_version",
    "wave_id",
    "lane_id",
    "title",
    "decisive_join",
    "selection_rule",
    "authority",
    "sources",
    "observations",
    "findings",
    "terminal_receipt"
  ],
  "title": "Residual-denominator decisive-join lane",
  "type": "object"
}
