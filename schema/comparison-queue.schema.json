{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/undercast/schema/comparison-queue.schema.json",
  "title": "UNDERCAST current comparison review queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "schema", "generated_from", "policy", "summary", "rows"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "schema": { "type": "string", "const": "schema/comparison-queue.schema.json" },
    "generated_from": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specimens_sha256", "reviews_sha256", "media_manifest_version"],
      "properties": {
        "specimens_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reviews_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "media_manifest_version": { "type": "integer", "minimum": 1 }
      }
    },
    "policy": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible_pairs", "approved", "needs_alignment", "needs_source", "pending", "stale"],
      "properties": {
        "eligible_pairs": { "type": "integer", "minimum": 0 },
        "approved": { "type": "integer", "minimum": 0 },
        "needs_alignment": { "type": "integer", "minimum": 0 },
        "needs_source": { "type": "integer", "minimum": 0 },
        "pending": { "type": "integer", "minimum": 0 },
        "stale": { "type": "integer", "minimum": 0 }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "character", "actor", "production", "status", "note", "still", "portrait"],
        "properties": {
          "id": { "type": "string", "pattern": "^UC-\\d+$" },
          "character": { "type": "string", "minLength": 1 },
          "actor": { "type": "string", "minLength": 1 },
          "production": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "enum": ["approved", "needs-alignment", "needs-source", "pending", "stale"] },
          "note": { "type": "string", "minLength": 1 },
          "still": { "$ref": "#/$defs/image" },
          "portrait": { "$ref": "#/$defs/image" }
        }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "sha256", "width", "height", "focus", "comparison"],
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "focus": { "type": ["object", "null"] },
        "comparison": { "type": ["object", "null"] }
      }
    }
  }
}
