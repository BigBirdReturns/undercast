{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/undercast/schema/clifford-number-hr-dissonance-counterpower-lane.schema.json",
  "title": "Clifford Number HR dissonance-counterpower lane",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "lane_id",
    "title",
    "terminal_state",
    "authority",
    "observations",
    "findings",
    "open_questions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "object_type": {
      "const": "dissonance_counterpower_lane"
    },
    "lane_id": {
      "type": "string",
      "pattern": "^HRDCP-0[1-6]$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "terminal_state": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ai_caused_chloe_moffat_death_claims_allowed",
        "canonical_product_effects_allowed",
        "control_adoption_allowed",
        "dissonance_purge_universal_claims_allowed",
        "employer_liability_findings_allowed",
        "employer_specific_causation_findings_allowed",
        "final_coroner_conclusion_claims_allowed",
        "graph_effects_allowed",
        "individual_culpability_findings_allowed",
        "legal_conclusions_allowed",
        "named_company_intent_or_misuse_beyond_public_record_allowed",
        "parent_wave_mutation_allowed",
        "private_source_publication_allowed",
        "protected_activity_classification_claims_allowed",
        "publication_effects_allowed",
        "universal_prevalence_findings_allowed",
        "victim_character_inferences_allowed"
      ],
      "properties": {
        "ai_caused_chloe_moffat_death_claims_allowed": {
          "const": false
        },
        "canonical_product_effects_allowed": {
          "const": false
        },
        "control_adoption_allowed": {
          "const": false
        },
        "dissonance_purge_universal_claims_allowed": {
          "const": false
        },
        "employer_liability_findings_allowed": {
          "const": false
        },
        "employer_specific_causation_findings_allowed": {
          "const": false
        },
        "final_coroner_conclusion_claims_allowed": {
          "const": false
        },
        "graph_effects_allowed": {
          "const": false
        },
        "individual_culpability_findings_allowed": {
          "const": false
        },
        "legal_conclusions_allowed": {
          "const": false
        },
        "named_company_intent_or_misuse_beyond_public_record_allowed": {
          "const": false
        },
        "parent_wave_mutation_allowed": {
          "const": false
        },
        "private_source_publication_allowed": {
          "const": false
        },
        "protected_activity_classification_claims_allowed": {
          "const": false
        },
        "publication_effects_allowed": {
          "const": false
        },
        "universal_prevalence_findings_allowed": {
          "const": false
        },
        "victim_character_inferences_allowed": {
          "const": false
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim",
          "source_ids",
          "state",
          "limits"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^HRDCP-0[1-6]-O0[1-6]$"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "state": {
            "type": "string",
            "minLength": 1
          },
          "limits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim",
          "source_ids",
          "status",
          "limits"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^HRDCP-0[1-6]-F0[1-4]$"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "bounded_synthesis",
              "independently_supported_scoped",
              "legal_boundary_recovered",
              "normative_control_not_adopted"
            ]
          },
          "limits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
