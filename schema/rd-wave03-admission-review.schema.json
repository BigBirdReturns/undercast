{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://undercast.example/schema/rd-wave03-admission-review.schema.json",
  "title": "RD-W03 offline admission review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "issue",
    "status",
    "parent_product",
    "capture_custody",
    "intake_custody",
    "policy",
    "authority",
    "summary",
    "reviews"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "review_id": {"const": "RD-W03-ADMISSION-REVIEW-01"},
    "issue": {"const": 413},
    "status": {"const": "complete_offline_refusal_review"},
    "parent_product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pull_request", "parent", "head", "tree"],
      "properties": {
        "pull_request": {"const": 409},
        "parent": {"$ref": "#/$defs/sha1"},
        "head": {"$ref": "#/$defs/sha1"},
        "tree": {"$ref": "#/$defs/sha1"}
      }
    },
    "capture_custody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supervisor_run_id",
        "supervisor_artifact_id",
        "supervisor_artifact_sha256",
        "verification_run_id",
        "verification_head",
        "verification_artifact_id",
        "verification_artifact_digest",
        "capture_receipt_sha256"
      ],
      "properties": {
        "supervisor_run_id": {"const": 31021882771},
        "supervisor_artifact_id": {"const": 8937114139},
        "supervisor_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "verification_run_id": {"const": 31029020122},
        "verification_head": {"$ref": "#/$defs/sha1"},
        "verification_artifact_id": {"const": 8940053176},
        "verification_artifact_digest": {"$ref": "#/$defs/digest"},
        "capture_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "intake_custody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["RD-01", "RD-02", "RD-04", "RD-05"],
      "properties": {
        "RD-01": {"$ref": "#/$defs/intake"},
        "RD-02": {"$ref": "#/$defs/intake"},
        "RD-04": {"$ref": "#/$defs/intake"},
        "RD-05": {"$ref": "#/$defs/intake"}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_source_requests",
        "automatic_admission",
        "required_bindings",
        "complete_binding_set_required",
        "ordinal_unit_inference_allowed",
        "generic_context_is_event_evidence",
        "candidate_date_is_event_date",
        "capture_time_is_event_time",
        "one_binding_may_imply_another"
      ],
      "properties": {
        "live_source_requests": {"const": 0},
        "automatic_admission": {"const": false},
        "required_bindings": {
          "const": ["official_object", "unit_identity", "event_class", "chronology", "bytes"]
        },
        "complete_binding_set_required": {"const": true},
        "ordinal_unit_inference_allowed": {"const": false},
        "generic_context_is_event_evidence": {"const": false},
        "candidate_date_is_event_date": {"const": false},
        "capture_time_is_event_time": {"const": false},
        "one_binding_may_imply_another": {"const": false}
      }
    },
    "authority": {"$ref": "#/$defs/authority"},
    "summary": {"$ref": "#/$defs/summary"},
    "reviews": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/review"}
    }
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_contacts",
        "external_reviews",
        "outside_human_dependency",
        "physical_user_action_required",
        "publication_effect",
        "adoption_effect",
        "graph_effect",
        "merge_authority"
      ],
      "properties": {
        "external_contacts": {"const": 0},
        "external_reviews": {"const": 0},
        "outside_human_dependency": {"const": false},
        "physical_user_action_required": {"const": false},
        "publication_effect": {"const": "none"},
        "adoption_effect": {"const": "none"},
        "graph_effect": {"const": "none"},
        "merge_authority": {"const": false}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objects",
        "required_bindings",
        "official_object_verified",
        "bytes_verified",
        "unit_identity_verified",
        "event_class_verified",
        "chronology_resolved",
        "custody_bindings_verified",
        "substantive_bindings_refused",
        "admitted_objects",
        "refused_objects",
        "classes_closed"
      ],
      "properties": {
        "objects": {"const": 9},
        "required_bindings": {"const": 45},
        "official_object_verified": {"const": 9},
        "bytes_verified": {"const": 9},
        "unit_identity_verified": {"const": 0},
        "event_class_verified": {"const": 0},
        "chronology_resolved": {"const": 0},
        "custody_bindings_verified": {"const": 18},
        "substantive_bindings_refused": {"const": 27},
        "admitted_objects": {"const": 0},
        "refused_objects": {"const": 9},
        "classes_closed": {"const": 0}
      }
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "artifact_id",
        "artifact_digest",
        "head",
        "plan_sha256",
        "receipt_sha256",
        "protocol_blob",
        "field_matrix_blob"
      ],
      "properties": {
        "run_id": {"type": "integer", "minimum": 1},
        "artifact_id": {"type": "integer", "minimum": 1},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "head": {"$ref": "#/$defs/sha1"},
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "protocol_blob": {"$ref": "#/$defs/sha1"},
        "field_matrix_blob": {"oneOf": [{"$ref": "#/$defs/sha1"}, {"type": "null"}]}
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "match_count"],
      "properties": {
        "query": {"type": "string", "minLength": 1},
        "match_count": {"type": "integer", "minimum": 0}
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_start", "line_end", "lines", "sha256"],
      "properties": {
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "lines": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "reasoned_refusal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason_codes"],
      "properties": {
        "status": {"const": "refused"},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_object_id",
        "lane_id",
        "unit_id",
        "event_class",
        "cell_id",
        "source_route_id",
        "source_contract",
        "capture",
        "analysis",
        "bindings",
        "decision"
      ],
      "properties": {
        "capture_object_id": {"type": "string", "pattern": "^RD-W03-XCAP-01-0[1-9]$"},
        "lane_id": {"enum": ["RD-01", "RD-02", "RD-04", "RD-05"]},
        "unit_id": {"type": "string", "minLength": 1},
        "event_class": {"type": "string", "minLength": 1},
        "cell_id": {"type": "string", "minLength": 1},
        "source_route_id": {"type": "string", "pattern": "^RD0[1245]-OFF-00[1-9]$"},
        "source_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intake_run_id",
            "intake_artifact_id",
            "intake_artifact_digest",
            "intake_head",
            "protocol_blob",
            "field_matrix_blob",
            "unit_mapping_status",
            "semantic_unit"
          ],
          "properties": {
            "intake_run_id": {"type": "integer", "minimum": 1},
            "intake_artifact_id": {"type": "integer", "minimum": 1},
            "intake_artifact_digest": {"$ref": "#/$defs/digest"},
            "intake_head": {"$ref": "#/$defs/sha1"},
            "protocol_blob": {"$ref": "#/$defs/sha1"},
            "field_matrix_blob": {"oneOf": [{"$ref": "#/$defs/sha1"}, {"type": "null"}]},
            "unit_mapping_status": {"enum": ["absent_opaque_edition_map", "explicit_unit_name", "explicit_state_code", "absent_opaque_member_map"]},
            "semantic_unit": {"type": ["string", "null"]}
          }
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "body_path",
            "body_sha256",
            "bytes",
            "content_type",
            "requested_url",
            "final_url",
            "http_status",
            "attempt_count",
            "followups_spawned",
            "body_drift",
            "initial_body_sha256"
          ],
          "properties": {
            "body_path": {"type": "string", "pattern": "^capture/objects/rd0[1245]-off-00[1-9]\\.html$"},
            "body_sha256": {"$ref": "#/$defs/sha256"},
            "bytes": {"type": "integer", "minimum": 1},
            "content_type": {"type": "string", "minLength": 1},
            "requested_url": {"type": "string", "format": "uri"},
            "final_url": {"type": "string", "format": "uri"},
            "http_status": {"const": 200},
            "attempt_count": {"const": 1},
            "followups_spawned": {"const": 0},
            "body_drift": {"const": true},
            "initial_body_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "analysis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "extractor",
            "title",
            "canonical_urls",
            "line_count",
            "normalized_text_sha256",
            "candidate_dates",
            "negative_matches",
            "positive_context_matches",
            "proofs"
          ],
          "properties": {
            "extractor": {"const": "python-html.parser-main-or-body-v1"},
            "title": {"type": "string", "minLength": 1},
            "canonical_urls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
            "line_count": {"type": "integer", "minimum": 1},
            "normalized_text_sha256": {"$ref": "#/$defs/sha256"},
            "candidate_dates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "negative_matches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/match"}},
            "positive_context_matches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/match"}},
            "proofs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/proof"}}
          }
        },
        "bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["official_object", "unit_identity", "event_class", "chronology", "bytes"],
          "properties": {
            "official_object": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "basis"],
              "properties": {"status": {"const": "verified"}, "basis": {"type": "string", "minLength": 1}}
            },
            "unit_identity": {"$ref": "#/$defs/reasoned_refusal"},
            "event_class": {"$ref": "#/$defs/reasoned_refusal"},
            "chronology": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "event_date", "capture_time_is_event_time", "reason_codes"],
              "properties": {
                "status": {"const": "unresolved"},
                "event_date": {"type": "null"},
                "capture_time_is_event_time": {"const": false},
                "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
              }
            },
            "bytes": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "sha256", "bytes"],
              "properties": {"status": {"const": "verified"}, "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 1}}
            }
          }
        },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "admitted", "classes_closed", "reason_codes"],
          "properties": {
            "status": {"const": "refused"},
            "admitted": {"const": false},
            "classes_closed": {"const": 0},
            "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    }
  }
}
