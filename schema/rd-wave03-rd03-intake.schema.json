{
  "$id": "https://github.com/BigBirdReturns/undercast/schema/rd-wave03-rd03-intake.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "admission": {
      "additionalProperties": false,
      "properties": {
        "automatic_admission": {
          "const": false
        },
        "candidate_result_is_evidence": {
          "const": false
        },
        "exact_capture_required": {
          "const": true
        },
        "required_bindings": {
          "items": {
            "enum": [
              "official_object",
              "unit_identity",
              "event_class",
              "chronology",
              "bytes"
            ]
          },
          "maxItems": 5,
          "minItems": 5,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "candidate_result_is_evidence",
        "automatic_admission",
        "exact_capture_required",
        "required_bindings"
      ],
      "type": "object"
    },
    "authority": {
      "additionalProperties": false,
      "properties": {
        "adoption_effect": {
          "const": "none"
        },
        "external_contacts": {
          "const": 0
        },
        "external_reviews": {
          "const": 0
        },
        "graph_effect": {
          "const": "none"
        },
        "outside_human_dependency": {
          "const": false
        },
        "publication_effect": {
          "const": "none"
        }
      },
      "required": [
        "outside_human_dependency",
        "external_contacts",
        "external_reviews",
        "publication_effect",
        "adoption_effect",
        "graph_effect"
      ],
      "type": "object"
    },
    "closure": {
      "additionalProperties": false,
      "properties": {
        "allow_at_intake": {
          "const": false
        },
        "classes_closed": {
          "const": 0
        },
        "law": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "classes_closed",
        "allow_at_intake",
        "law"
      ],
      "type": "object"
    },
    "frozen_units": {
      "additionalProperties": false,
      "properties": {
        "count": {
          "const": 5
        },
        "ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 5,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "count",
        "ids"
      ],
      "type": "object"
    },
    "lane_id": {
      "const": "RD-03"
    },
    "matrix": {
      "additionalProperties": false,
      "properties": {
        "cell_ids_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "contract_mode": {
          "enum": [
            "embedded_immutable_input",
            "separate_immutable_input"
          ]
        },
        "contract_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "contract_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "embedded_field_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 11,
          "minItems": 11,
          "type": [
            "array",
            "null"
          ],
          "uniqueItems": true
        },
        "field_count": {
          "const": 11
        },
        "required_cells": {
          "const": 55
        }
      },
      "required": [
        "contract_mode",
        "contract_path",
        "contract_sha256",
        "field_count",
        "required_cells",
        "cell_ids_sha256",
        "embedded_field_ids"
      ],
      "type": "object"
    },
    "permanent_paths": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 7,
      "minItems": 7,
      "type": "array",
      "uniqueItems": true
    },
    "request_policy": {
      "additionalProperties": false,
      "properties": {
        "automatic_second_pass": {
          "const": false
        },
        "concurrency": {
          "const": 2
        },
        "maximum_attempts": {
          "const": 1
        },
        "maximum_body_bytes": {
          "const": 5242880
        },
        "method": {
          "const": "GET"
        },
        "result_spawned_followups": {
          "const": 0
        },
        "timeout_ms": {
          "const": 45000
        }
      },
      "required": [
        "method",
        "maximum_attempts",
        "timeout_ms",
        "maximum_body_bytes",
        "concurrency",
        "result_spawned_followups",
        "automatic_second_pass"
      ],
      "type": "object"
    },
    "routes": {
      "additionalProperties": false,
      "properties": {
        "candidate_count": {
          "const": 45
        },
        "candidate_family": {
          "additionalProperties": false,
          "properties": {
            "affiliate": {
              "minLength": 1,
              "type": "string"
            },
            "base_url": {
              "pattern": "^https://",
              "type": "string"
            },
            "order": {
              "const": "unit_major_field_minor_variant_minor"
            },
            "query_prefix": {
              "minLength": 1,
              "type": "string"
            },
            "route_id_prefix": {
              "minLength": 1,
              "type": "string"
            },
            "site_filter": {
              "minLength": 1,
              "type": "string"
            },
            "take": {
              "const": 45
            },
            "variants": {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "route_id_prefix",
            "base_url",
            "affiliate",
            "site_filter",
            "query_prefix",
            "variants",
            "take",
            "order"
          ],
          "type": "object"
        },
        "expanded_route_ids_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "expanded_route_urls_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "official": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "cell_id": {
                "minLength": 1,
                "type": "string"
              },
              "route_id": {
                "minLength": 1,
                "type": "string"
              },
              "url": {
                "pattern": "^https://",
                "type": "string"
              }
            },
            "required": [
              "route_id",
              "url",
              "cell_id"
            ],
            "type": "object"
          },
          "maxItems": 5,
          "minItems": 5,
          "type": "array",
          "uniqueItems": true
        },
        "official_count": {
          "const": 5
        },
        "total_count": {
          "const": 50
        }
      },
      "required": [
        "official_count",
        "candidate_count",
        "total_count",
        "official",
        "candidate_family",
        "expanded_route_ids_sha256",
        "expanded_route_urls_sha256"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "pre_execution_intake"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "wave_id": {
      "const": "RD-W03"
    }
  },
  "required": [
    "schema_version",
    "wave_id",
    "lane_id",
    "title",
    "status",
    "permanent_paths",
    "frozen_units",
    "matrix",
    "routes",
    "request_policy",
    "admission",
    "authority",
    "closure"
  ],
  "title": "RD-03 Wave-03 fixed intake protocol",
  "type": "object"
}
