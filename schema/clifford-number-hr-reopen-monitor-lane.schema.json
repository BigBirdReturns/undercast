{
  "$id": "https://bigbirdreturns.github.io/undercast/schema/clifford-number-hr-reopen-monitor-lane.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "as_of": {
      "format": "date",
      "type": "string"
    },
    "authority": {
      "type": "object"
    },
    "case_id": {
      "minLength": 3,
      "type": "string"
    },
    "findings": {
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "lane_id": {
      "pattern": "^HRRM-0[1-6]$"
    },
    "lifecycle_state": {
      "minLength": 3,
      "type": "string"
    },
    "name": {
      "minLength": 3,
      "type": "string"
    },
    "next_review_date": {
      "format": "date",
      "type": "string"
    },
    "observations": {
      "maxItems": 6,
      "minItems": 6,
      "type": "array"
    },
    "reopen_triggers": {
      "items": {
        "type": "string"
      },
      "minItems": 5,
      "type": "array",
      "uniqueItems": true
    },
    "schema_version": {
      "const": 1
    },
    "source_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 4,
      "type": "array",
      "uniqueItems": true
    },
    "terminal_receipt": {
      "type": "object"
    },
    "wave_id": {
      "const": "CN-HRRM-W10"
    }
  },
  "required": [
    "schema_version",
    "wave_id",
    "lane_id",
    "case_id",
    "name",
    "lifecycle_state",
    "as_of",
    "next_review_date",
    "source_ids",
    "observations",
    "findings",
    "reopen_triggers",
    "terminal_receipt",
    "authority"
  ],
  "title": "Clifford Number HR recurrence-and-reopen lane",
  "type": "object"
}
