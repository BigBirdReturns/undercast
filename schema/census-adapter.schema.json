{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/undercast/schema/census-adapter.schema.json",
  "title": "UNDERCAST census adapter registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "schema", "semantics", "adapters"],
  "properties": {
    "version": { "const": 1 },
    "schema": { "const": "schema/census-adapter.schema.json" },
    "semantics": { "type": "string", "minLength": 20 },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/adapter" }
    }
  },
  "$defs": {
    "safeId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "args"],
      "properties": {
        "executable": { "type": "string", "minLength": 1 },
        "args": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "outputContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_path",
        "franchise_field",
        "source_field",
        "page_id_field",
        "revision_field",
        "content_hash_field",
        "observed_at_field",
        "require_exact_revision_receipt",
        "collapse_duplicate_source_revisions"
      ],
      "properties": {
        "manifest_path": { "const": "data/CENSUS-MANIFEST.json" },
        "franchise_field": { "const": "franchise" },
        "source_field": { "const": "source" },
        "page_id_field": { "const": "pageid" },
        "revision_field": { "const": "revision" },
        "content_hash_field": { "const": "content_sha256" },
        "observed_at_field": { "const": "observed_at" },
        "require_exact_revision_receipt": { "const": true },
        "collapse_duplicate_source_revisions": { "const": true }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scope_id",
        "estate_id",
        "franchise",
        "status",
        "source_hosts",
        "command",
        "producer_files",
        "output_contract",
        "semantic_controls",
        "certification_effect",
        "next_gate"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "scope_id": { "$ref": "#/$defs/safeId" },
        "estate_id": { "$ref": "#/$defs/safeId" },
        "franchise": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["certified-reference", "review-candidate", "blocked"]
        },
        "source_hosts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          }
        },
        "command": { "$ref": "#/$defs/command" },
        "producer_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "output_contract": { "$ref": "#/$defs/outputContract" },
        "semantic_controls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 8 }
        },
        "certification_effect": { "const": false },
        "next_gate": { "type": "string", "minLength": 20 }
      }
    }
  }
}
