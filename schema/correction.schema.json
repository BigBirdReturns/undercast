{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/undercast/schema/correction.schema.json",
  "title": "UNDERCAST correction ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "schema", "semantics", "cases"],
  "properties": {
    "version": { "const": 1 },
    "schema": { "const": "schema/correction.schema.json" },
    "semantics": { "type": "string", "minLength": 20 },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "value", "sha256"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["repository", "source", "issue", "workflow", "statement", "comparison"] },
        "value": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "at", "actor", "role", "note", "evidence_ids"],
      "properties": {
        "kind": { "enum": ["intake", "triaged", "evidence-reviewed", "dispositioned", "history-published"] },
        "at": { "type": "string", "format": "date-time" },
        "actor": { "type": "string", "minLength": 1 },
        "role": { "enum": ["reporter", "intake", "reviewer", "second-desk", "owner"] },
        "note": { "type": "string", "minLength": 10 },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "case_type",
        "status",
        "opened_at",
        "target",
        "claim",
        "privacy",
        "evidence",
        "events",
        "disposition",
        "boundary"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "case_type": { "enum": ["real", "exercise"] },
        "status": { "enum": ["open", "triage", "review", "resolved", "rejected", "withdrawn"] },
        "opened_at": { "type": "string", "format": "date-time" },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_id", "field_path", "target_head", "current_value_sha256"],
          "properties": {
            "record_id": { "type": "string", "minLength": 1 },
            "field_path": { "type": "string", "minLength": 1 },
            "target_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "current_value_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "claim": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary", "proposed_correction"],
          "properties": {
            "summary": { "type": "string", "minLength": 10 },
            "proposed_correction": { "type": "string", "minLength": 1 }
          }
        },
        "privacy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["private_personal_data_included", "public_evidence_only"],
          "properties": {
            "private_personal_data_included": { "const": false },
            "public_evidence_only": { "const": true }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/event" }
        },
        "disposition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "reason", "decided_by", "decided_role", "decided_at", "canonical_mutation", "history_public"],
          "properties": {
            "outcome": { "enum": ["accepted", "rejected", "insufficient-evidence", "withdrawn", "pending"] },
            "reason": { "type": "string", "minLength": 10 },
            "decided_by": { "type": ["string", "null"] },
            "decided_role": { "type": ["string", "null"], "enum": ["second-desk", "owner", null] },
            "decided_at": { "type": ["string", "null"], "format": "date-time" },
            "canonical_mutation": { "type": "boolean" },
            "history_public": { "type": "boolean" }
          }
        },
        "boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonical_authority", "exercise_can_mutate_canonical", "reporter_can_self_adjudicate"],
          "properties": {
            "canonical_authority": { "const": false },
            "exercise_can_mutate_canonical": { "const": false },
            "reporter_can_self_adjudicate": { "const": false }
          }
        }
      }
    }
  }
}
