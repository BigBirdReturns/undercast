{
  "$id": "https://github.com/BigBirdReturns/undercast/schema/clifford-number-hr-verification-lane.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "type": "object"
    },
    "decisive_join": {
      "minLength": 1,
      "type": "string"
    },
    "findings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "claim": {
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "pattern": "^hrv0[1-6]-f[1-9][0-9]*$",
            "type": "string"
          },
          "limits": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "status": {
            "enum": [
              "independently_supported_scoped",
              "bounded_synthesis",
              "remains_blocked"
            ]
          },
          "wave_01_finding_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "id",
          "claim",
          "status",
          "source_ids",
          "wave_01_finding_ids",
          "limits"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "lane_id": {
      "pattern": "^HRV-0[1-6]$",
      "type": "string"
    },
    "observations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "state": {
            "enum": [
              "observed",
              "observed_uncertainty",
              "observed_vendor_claim",
              "observed_vendor_description",
              "observed_mechanism",
              "observed_framework",
              "observed_study",
              "observed_experiment",
              "observed_experiments",
              "observed_meta_analysis",
              "not_applicable",
              "blocked"
            ]
          },
          "subject": {
            "type": "string"
          },
          "value": {}
        },
        "required": [
          "id",
          "subject",
          "field",
          "state",
          "value",
          "source_ids",
          "notes"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": 1
    },
    "selection_rule": {
      "minLength": 1,
      "type": "string"
    },
    "source_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "terminal_receipt": {
      "additionalProperties": false,
      "properties": {
        "closed_questions": {
          "maxItems": 0,
          "type": "array"
        },
        "open_questions": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "prohibited_inferences": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "state": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "state",
        "closed_questions",
        "open_questions",
        "prohibited_inferences"
      ],
      "type": "object"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "wave_id": {
      "const": "CN-HR-W02"
    }
  },
  "required": [
    "schema_version",
    "wave_id",
    "lane_id",
    "title",
    "decisive_join",
    "selection_rule",
    "authority",
    "source_ids",
    "observations",
    "findings",
    "terminal_receipt"
  ],
  "title": "Clifford Number HR independent-source adjudication lane",
  "type": "object"
}
