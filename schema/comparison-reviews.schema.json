{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/undercast/schema/comparison-reviews.schema.json",
  "title": "UNDERCAST comparison review ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "schema", "policy", "reviews"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "schema": { "type": "string", "const": "schema/comparison-reviews.schema.json" },
    "policy": { "type": "string", "minLength": 1 },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "still_sha256", "portrait_sha256", "note"],
        "properties": {
          "id": { "type": "string", "pattern": "^UC-\\d+$" },
          "status": { "type": "string", "enum": ["approved", "needs-alignment", "needs-source"] },
          "still_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "portrait_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "note": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    }
  }
}
