{
  "$id": "https://bigbirdreturns.github.io/undercast/schema/clifford-number-hr-disciplinary-sentinel-lane.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "type": "object"
    },
    "case_id": {
      "minLength": 4,
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "findings": {
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "lane_id": {
      "pattern": "^HRDS-0[1-6]$"
    },
    "name": {
      "minLength": 3,
      "type": "string"
    },
    "observations": {
      "maxItems": 6,
      "minItems": 6,
      "type": "array"
    },
    "schema_version": {
      "const": 1
    },
    "source_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 4,
      "type": "array",
      "uniqueItems": true
    },
    "terminal_receipt": {
      "type": "object"
    },
    "wave_id": {
      "const": "CN-HRDS-W08"
    }
  },
  "required": [
    "schema_version",
    "wave_id",
    "lane_id",
    "case_id",
    "name",
    "domain",
    "source_ids",
    "observations",
    "findings",
    "terminal_receipt",
    "authority"
  ],
  "title": "Clifford Number HR disciplinary sentinel lane",
  "type": "object"
}
